# Mimoia — environment variables. Copy to `.env` at the repo root for local dev.
# The API reads everything through apps/api/src/config/env.ts (defaults there);
# NEXT_PUBLIC_* are baked into the web build. Production values live in Railway
# (docs/deploy.md) — never commit real secrets.

# ── Core ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ona
API_PORT=8000
# Required, ≥ 32 chars on a deployed API (Railway / NODE_ENV=production) or it
# refuses to boot. Generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=90d
# Comma-separated emails promoted to admin on login
ADMIN_EMAILS=
# PR 1B household scope for menus / shopping / favourites (default: on unless NODE_ENV=production)
SHARED_HOUSEHOLD_SCOPE=
# Base the assistant uses to call this API as the user (default http://127.0.0.1:$API_PORT)
INTERNAL_API_URL=

# ── Web ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public web origin, for links the API sends (WhatsApp, emails)
WEB_PUBLIC_URL=http://localhost:3000
# Contact shown in /privacidad
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── AI providers ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Mimo's replies read aloud (POST /tts, specs/voice-mode.md). Optional: unset = the browser's voice.
# ELEVENLABS_VOICES is "Nombre:voiceId,Nombre:voiceId" (first = default). Library voices need a paid plan.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICES=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Spend limits (specs/advisor.md → Cost guardrail) ─────────────
# Text chat budget per user per month, euros
ADVISOR_MONTHLY_BUDGET_EUR=5
ADVISOR_EUR_PER_USD=0.92
# Monthly cap on ALL paid AI work per user, euros (0 = off). Admins exempt.
USER_MONTHLY_SPEND_CAP_EUR=10
# AI recipe images per user per month
IMAGE_GEN_MONTHLY_LIMIT=20

# ── Recipe images (AiKit) ────────────────────────────────────────
AIKIT_API_KEY=
# Where regenerated images are written / served from (prod: Railway volume /data)
IMAGE_STORAGE_DIR=
IMAGE_PUBLIC_URL_BASE=/images/recipes

# ── Nutrition ────────────────────────────────────────────────────
# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup)
USDA_FDC_API_KEY=

# ── Web Push (VAPID; `npx web-push generate-vapid-keys`) ─────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@ona.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Voice wake word (https://console.picovoice.ai) ───────────────
# Without it, Mimo opens only from its floating button (no wake word).
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=

# ── WhatsApp (Meta Cloud API, specs/whatsapp.md) ─────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Sender number as digits, for wa.me links
WHATSAPP_DISPLAY_NUMBER=
# Comma-separated Mimoia emails allowed to link a phone (empty = everyone)
WHATSAPP_ALLOWED_EMAILS=
# Approved utility template for proactive messages outside the 24 h window
WHATSAPP_TEMPLATE_NAME=
# Per-kind approved templates (JSON), preferred over the generic one, e.g.
# {"daily_brief":"ona_menu_de_hoy","alert":"ona_aviso_preparacion","weekly_nudge":"ona_plan_semana"}
WHATSAPP_TEMPLATES=
WHATSAPP_TEMPLATE_LANG=es
# Who receives the daily conversation review
WHATSAPP_REVIEW_EMAILS=
WHATSAPP_GRAPH_VERSION=v26.0
# Local E2E points this at a mock Graph server
WHATSAPP_GRAPH_BASE_URL=
# Human contact for "HUMANO" and the suspended-account copy
SUPPORT_EMAIL=

# ── Business metrics (specs/metrics.md) ──────────────────────────
# Read-only token for GET /admin/metrics (header x-metrics-token). Empty = off.
METRICS_READ_TOKEN=
# Optional JSON overrides for config/pricing.ts, e.g. {"openai/gpt-realtime":{"perMinute":0.15}}
COST_PRICE_OVERRIDES=

# ── Tests only ───────────────────────────────────────────────────
# Disables rate limits for e2e/CI; ignored on a deployed runtime
RATE_LIMIT_DISABLED=
# Closed beta (PRO-27): invite (default) | open. Production stays invite until launch day.
REGISTRATION_MODE=invite
