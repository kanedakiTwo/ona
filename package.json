      "nanoid@>=3 <4": "^3.3.20",
      "postcss@>=8 <9": "^8.5.29",
      "serialize-javascript": "^7.1.2",
      "source-map-js": "^1.2.2",
      "undici@>=7 <8": "^7.30.0",
      "@babel/plugin-transform-modules-systemjs": "^7.29.8",
